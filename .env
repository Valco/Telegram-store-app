# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# PostgreSQL connection string for Prisma
# Local development (Docker Compose): postgresql://dev_user:dev_password@localhost:5432/tel_bot_store
DATABASE_URL="postgresql://dev_user:dev_password@localhost:5432/tel_bot_store?schema=public"

# JWT Secret for admin sessions (MUST be changed in production!)
JWT_SECRET_KEY="local_dev_secret_change_this_in_production"

# Public URL of the store (used in Monobank redirects, receipts, etc.)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Telegram Bot (Optional for local frontend testing, mandatory for webhook verifications)
TELEGRAM_BOT_TOKEN="xxx"

# Monobank / Nova Poshta API (can remain empty during structural UI tests)
MONOBANK_API_KEY="xxx"
NOVA_POSHTA_API_KEY="xxx"
CHECKBOX_LICENSE_KEY=""

# SMTP Settings
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="xxx"
SMTP_PASS="xxx"
SMTP_ADMIN_EMAIL="admin@tel.bot"
SMTP_FROM_EMAIL="admin@tel.bot"

# AI Integrations (moved from DB Settings to .env for security)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"

PHOTOROOM_SANDBOX_KEY=""
PHOTOROOM_LIVE_KEY=""
PHOTOROOM_ENVIRONMENT="sandbox"

# AWS S3 Storage (optional, only if storageProvider=s3)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_BUCKET_NAME=""
AWS_REGION=""

# =============================================================
# DEPLOY SETTINGS (використовується deploy.sh)
# =============================================================
DEPLOY_USER="your_ssh_user"
DEPLOY_HOST="your-server.com"
DEPLOY_PORT="22"
DEPLOY_PROJECT_DIR="~/projects/store"
DEPLOY_PM2_NAME="store-app"
DEPLOY_NEXTJS_PORT="4000"
