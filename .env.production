# PostgreSQL connection string
DATABASE_URL="postgresql://store_user:REPLACE_DB_PASSWORD@localhost:5432/store_db?schema=public"

# Public URL of the store
NEXT_PUBLIC_BASE_URL="https://your-domain.com"

# JWT Secret for admin sessions (CHANGE THIS to a long random string!)
JWT_SECRET_KEY="REPLACE_WITH_STRONG_SECRET_AT_LEAST_32_CHARS"

# Telegram Bot
TELEGRAM_BOT_TOKEN="xxx"

# API Keys
MONOBANK_API_KEY="xxx"
NOVA_POSHTA_API_KEY="xxx"
CHECKBOX_LICENSE_KEY=""

# SMTP Settings
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="xxx"
SMTP_PASS="xxx"
SMTP_ADMIN_EMAIL="admin@tel.bot"
SMTP_FROM_EMAIL="admin@tel.bot"

# AI Integrations (moved from DB Settings to .env for security)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"

PHOTOROOM_SANDBOX_KEY=""
PHOTOROOM_LIVE_KEY=""
PHOTOROOM_ENVIRONMENT="live"

KLING_API_KEY=""
KLING_API_SECRET=""

# AWS S3 Storage (optional, only if storageProvider=s3)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_BUCKET_NAME=""
AWS_REGION=""

# =============================================================
# DEPLOY SETTINGS (використовується deploy.sh)
# =============================================================
DEPLOY_USER="your_ssh_user"
DEPLOY_HOST="your-server.com"
DEPLOY_PORT="22"
DEPLOY_PROJECT_DIR="~/projects/store"
DEPLOY_PM2_NAME="store-app"
DEPLOY_NEXTJS_PORT="4000"
